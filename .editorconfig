# Editor defaults that hold for every file. Indentation is left to each file's
# own formatter, because the files here do not share one width; nixfmt, the only
# formatter enforced, indents Nix with two spaces.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.nix]
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
